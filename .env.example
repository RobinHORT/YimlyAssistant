# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==============================================================================
# Home Assistant Core & Yimly Server Settings
# ==============================================================================
# Port exposed for Home Assistant API, WebSocket, and Companion App
HA_PORT=8123

# Port exposed for Yimly UI Web Application
PORT=3000
YIMLY_PORT=3000

# Path to persistent Home Assistant configuration directory
HA_CONFIG_VOLUME=./config

# Timezone for Home Assistant Core (e.g., America/New_York, UTC, Asia/Tokyo)
TZ=UTC

# External Docker network for Cloudflare Tunnel integration
CLOUDFLARE_NETWORK=cloudflare_tunnel_net

# Long-lived access token (optional, can also be created via UI onboarding)
HA_ACCESS_TOKEN=

